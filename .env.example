DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

PUBLIC_URL="http://localhost:5173"

# Git commit SHA for version display in footer (baked in at build time)
# In Nix builds, this is automatically set from self.rev
PUBLIC_GIT_COMMIT_SHA="development"

# Passkey/WebAuthn Configuration
RP_NAME="Tietokilta Rekisteri"
RP_ID="localhost"
RP_ORIGIN="http://localhost:5173"

STRIPE_API_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# SMTP Configuration
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="user@example.com"
SMTP_PASS="password"
SMTP_FROM="TiK-Rekisteri <noreply@rekisteri.tietokilta.fi>"

# adapter-node: Header to use for client IP address (Azure App Service provides X-Client-IP)
# Azure overwrites this header to prevent spoofing and excludes port numbers (unlike X-Forwarded-For)
# See: https://svelte.dev/docs/kit/adapter-node
# Azure docs: https://github.com/Azure/app-service-linux-docs/blob/master/Things_You_Should_Know/headers.md
# Reference: https://learn.microsoft.com/en-us/answers/questions/819540/documentation-on-x-client-ip-http-header
ADDRESS_HEADER=X-Client-IP

# OIDC provider signing key: Base64 of a private JWK, a JWK Set ({"keys": [...]}) or PEM private key block(s).
# The first key signs; the others are only published so their tokens keep verifying. Each key's kid is
# its RFC 7638 thumbprint. Required in production; in dev and tests a throwaway key is generated if unset.
# Generate with: pnpm oidc:generate-key
# OIDC_SIGNING_KEY_JWK="eyJrdHkiOiJSU0Ei..."

# Secrets for signing the OIDC provider's cookies, comma-separated; the first signs, all verify (add a new
# one first to rotate). At least 32 characters each. Required in production; generate with: openssl rand -base64 32
# OIDC_COOKIE_KEYS="..."

# Serve the OIDC provider (endpoints, login/consent pages, admin and user settings). Off by default.
# OIDC_ENABLED=true

