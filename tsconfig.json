{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true,
    "sourceMap": true,
    "strict": true
  },
  "include": [
    ".svelte-kit/ambient.d.ts",
    ".svelte-kit/non-ambient.d.ts",
    ".svelte-kit/types/**/$types.d.ts",
    "vite.config.js",
    "vite.config.ts",
    "src/**/*.js",
    "src/**/*.ts",
    "src/**/*.svelte",
    "tests/**/*.js",
    "tests/**/*.ts",
    "tests/**/*.svelte",
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "*.config.ts",
    "*.config.js"
  ]
}
