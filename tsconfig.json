{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true,
    "sourceMap": true,
    "strict": true,
    // Mirrors `imports` in package.json for tools that resolve through tsconfig, not Node:
    // Playwright and tsx map `#lib/foo.js` to `src/lib/foo.ts` only via `paths`
    "paths": {
      "#lib/*": ["./src/lib/*"]
    }
  },
  "include": [
    ".svelte-kit/types/**/$types.d.ts",
    "vite.config.js",
    "vite.config.ts",
    "src/**/*.js",
    "src/**/*.ts",
    "src/**/*.svelte",
    "tests/**/*.js",
    "tests/**/*.ts",
    "tests/**/*.svelte",
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "*.config.ts",
    "*.config.js"
  ]
}
