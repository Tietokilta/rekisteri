{
  "name": "rekisteri",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "[ -n \"$NIX_BUILD_TOP\" ] || (svelte-kit sync && pnpm i18n:generate)",
    "dev": "concurrently -n vite,i18n -c cyan,magenta \"vite dev\" \"pnpm i18n:watch\"",
    "build": "pnpm i18n:generate && vite build",
    "flake:upgrade": "docker run --rm -v $(pwd):/app -w /app nixpkgs/nix-flakes sh -c \"git config --global --add safe.directory /app && nix flake update\"",
    "flake:build": "docker run --rm -v $(pwd):/app -w /app nixpkgs/nix-flakes sh -c \"git config --global --add safe.directory /app && nix build .#docker\"",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --experimental-cli --write .",
    "lint": "prettier --experimental-cli --check . && eslint .",
    "fallow": "fallow",
    "fallow:summary": "fallow --summary",
    "test:e2e": "playwright test",
    "test:integration": "vitest run",
    "test": "pnpm run test:e2e",
    "db:start": "docker compose up",
    "db:clear": "docker compose down -v",
    "db:reset": "pnpm db:clear && pnpm db:start -d --wait && pnpm db:migrate && pnpm db:seed",
    "db:seed": "tsx --env-file=.env src/lib/server/db/seed.ts",
    "db:check": "drizzle-kit check",
    "oidc:generate-key": "tsx scripts/generate-oidc-key.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "i18n:generate": "typesafe-i18n --no-watch",
    "i18n:watch": "typesafe-i18n",
    "typesafe-i18n": "typesafe-i18n"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.61.0",
    "@playwright/test": "^1.64.1",
    "@prettier/plugin-oxc": "^0.2.3",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/svelte-table": "^9.3.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^24.19.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/oidc-provider": "^9.12.1",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "bits-ui": "^2.20.2",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-seed": "1.0.0-rc.4",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "eslint-plugin-unicorn": "^79.0.0",
    "fallow": "^3.36.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte-check": "^4.7.7",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "^8.3.5",
    "vite-plugin-devtools-json": "^1.1.2",
    "vite-plugin-kit-routes": "^1.1.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@oslojs/encoding": "^1.1.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "drizzle-orm": "1.0.0-rc.4",
    "marked": "^18.1.1",
    "mode-watcher": "^1.1.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.2.1",
    "oidc-provider": "^9.13.0",
    "papaparse": "^5.7.0",
    "postgres": "^3.4.9",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "runed": "^0.37.1",
    "stripe": "^23.0.1",
    "svelte": "^5.57.2",
    "typesafe-i18n": "^5.27.1",
    "valibot": "^1.5.0"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.22.0 <25.0.0"
  }
}
