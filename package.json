{
  "name": "rekisteri",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "[ -n \"$NIX_BUILD_TOP\" ] || (svelte-kit sync && pnpm i18n:generate)",
    "dev": "concurrently -n vite,i18n -c cyan,magenta \"vite dev\" \"pnpm i18n:watch\"",
    "build": "pnpm i18n:generate && vite build",
    "flake:upgrade": "docker run --rm -v $(pwd):/app -w /app nixpkgs/nix-flakes sh -c \"git config --global --add safe.directory /app && nix flake update\"",
    "flake:build": "docker run --rm -v $(pwd):/app -w /app nixpkgs/nix-flakes sh -c \"git config --global --add safe.directory /app && nix build .#docker\"",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --experimental-cli --write .",
    "lint": "prettier --experimental-cli --check . && eslint .",
    "fallow": "fallow",
    "fallow:summary": "fallow --summary",
    "test:e2e": "playwright test",
    "test:integration": "vitest run",
    "test": "pnpm run test:e2e",
    "db:start": "docker compose up",
    "db:clear": "docker compose down -v",
    "db:reset": "pnpm db:clear && pnpm db:start -d --wait && pnpm db:migrate && pnpm db:seed",
    "db:seed": "tsx --env-file=.env src/lib/server/db/seed.ts",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "i18n:generate": "typesafe-i18n --no-watch",
    "i18n:watch": "typesafe-i18n",
    "typesafe-i18n": "typesafe-i18n"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^0.577.0",
    "@playwright/test": "^1.62.1",
    "@prettier/plugin-oxc": "^0.2.2",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/svelte-table": "^9.1.2",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^24.13.3",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.4",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-seed": "1.0.0-rc.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "fallow": "^3.14.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte-check": "^4.7.5",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "^8.2.1",
    "vite-plugin-devtools-json": "^1.1.0",
    "vite-plugin-kit-routes": "^1.0.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "drizzle-orm": "1.0.0-rc.4",
    "marked": "^18.0.9",
    "mode-watcher": "^1.1.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "papaparse": "^5.5.4",
    "postgres": "^3.4.9",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "runed": "^0.37.1",
    "stripe": "^22.4.0",
    "svelte": "^5.56.8",
    "typesafe-i18n": "^5.27.1",
    "valibot": "^1.4.2"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.22.0 <25.0.0"
  }
}
